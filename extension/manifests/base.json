{
  "manifest_version": 3,
  "name": "SiteNotes",
  "version": "1.1.0",
  "description": "Permite ao SiteNotes reconhecer as abas abertas e resolver o titulo da pagina ou do video.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "incognito": "spanning",
  "action": {
    "default_title": "SiteNotes",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://10.0.0.50/*",
        "*://sitenotes/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
