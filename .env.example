# Copie para .env e ajuste se quiser (cp .env.example .env).
# Valores abaixo são só para desenvolvimento local.

MONGO_ROOT_USERNAME=sitenotes
MONGO_ROOT_PASSWORD=sitenotes_local_dev
MONGO_DATABASE=SiteNotesDb
MONGO_HOST_PORT=27017

API_HOST_PORT=5210
FRONTEND_HOST_PORT=4200
FRONTEND_ORIGIN=http://localhost:4200
# Origem do NGINX no WSL (porta 80). Ajuste se usar outro hostname (ex.: http://sitenotes.local).
NGINX_ORIGIN=http://localhost

ASPNETCORE_ENVIRONMENT=Development
