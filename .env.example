# Copie para .env e ajuste se quiser (cp .env.example .env).
# Valores abaixo são só para desenvolvimento local.
#
# No Docker Compose, frontend <-> api <-> postgres usam a rede "sitenotes".
# Só o frontend é publicado no host (FRONTEND_HOST_PORT).

POSTGRES_USER=sitenotes
POSTGRES_PASSWORD=sitenotes_local_dev
POSTGRES_DB=sitenotes

# Porta do frontend no host. Acesso na rede: http://<IP-da-maquina>:4200
FRONTEND_HOST_PORT=4200

# Origem liberada no CORS da API. Com API_BASE_URL=/api (padrao do Compose) o browser
# usa a mesma origem do frontend e este valor quase nao e usado.
# Se o app chamar a API em outra origem, coloque a URL do frontend na maquina/rede,
# ex.: http://10.0.0.50:4200 ou http://sitenotes
FRONTEND_ORIGIN=http://localhost:4200

ASPNETCORE_ENVIRONMENT=Development

# Opcionais: so se voce descomentar "ports" de postgres/api no docker-compose.yml
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=5210
