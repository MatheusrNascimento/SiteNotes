{
  "name": "sitenotes-extension",
  "version": "1.1.0",
  "private": true,
  "description": "Extensao do SiteNotes: lista abas abertas e resolve titulos de pagina para o app.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
